    "maturity": 100,
    "adaptation": false,
    "l2_lambda": 0.001,
    "shrink": 0.999,
    "perturb": 0.0001,
    "every": 1000
  },
  "sleep": {
    "wake_steps": 5000,
    "replay": false,
    "memory_size": 1024,
    "replay_steps": 100,
    "slow_ema": 0.0,
    "consolidate": 0.0
  }
