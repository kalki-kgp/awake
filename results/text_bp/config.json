{
  "run": {
    "name": null,
    "device": "gpu",
    "seed": 0,
    "batch_size": 1,
    "max_steps": 0,
    "max_steps_per_sec": 0,
    "log_every": 200,
    "ckpt_every": 0,
    "compile": true
  },
  "stream": {
    "kind": "text",
    "path": "~/.cache/awake/text/tinyshakespeare.txt",
